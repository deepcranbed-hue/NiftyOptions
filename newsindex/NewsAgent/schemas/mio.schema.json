{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsindex/NewsAgent/schemas/mio.schema.json",
  "title": "Market Intelligence Object",
  "description": "The single standardized object the News Intelligence Agent emits to every downstream trading agent. Explainability (causal chain), horizon-separated impact, the confidence triple, and driver-dominance are required by construction.",
  "type": "object",
  "required": [
    "mio_id",
    "as_of",
    "graph_version",
    "regime_version",
    "event",
    "theme",
    "regime",
    "transmission",
    "affected_sectors",
    "affected_companies",
    "expected_direction",
    "impact",
    "confidence",
    "driver_dominance",
    "provenance"
  ],
  "properties": {
    "mio_id": { "type": "string" },
    "as_of": { "type": "string", "format": "date-time" },
    "graph_version": { "type": "string" },
    "regime_version": { "type": "string" },
    "degraded": { "type": "boolean", "default": false },

    "event": {
      "type": "object",
      "required": ["event_id", "canonical_label", "class"],
      "properties": {
        "event_id": { "type": "string" },
        "canonical_label": { "type": "string" },
        "class": {
          "type": "string",
          "enum": ["Economic", "Corporate", "Policy", "Geopolitical", "Market"]
        },
        "novelty": { "type": "number", "minimum": 0, "maximum": 1 },
        "surprise": { "type": "number", "minimum": 0, "maximum": 1 },
        "member_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "source_tier"],
            "properties": {
              "source": { "type": "string" },
              "source_tier": { "type": "integer", "minimum": 1, "maximum": 5 },
              "url": { "type": "string" },
              "ts_event": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },

    "theme": { "type": "string" },

    "regime": {
      "type": "object",
      "required": ["active", "primary", "confidence"],
      "properties": {
        "active": { "type": "array", "items": { "type": "string" } },
        "primary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "shock_type": {
      "type": "string",
      "enum": ["supply", "demand", "inventory", "speculation", "policy", "none"]
    },

    "transmission": {
      "type": "array",
      "minItems": 1,
      "description": "Required causal chains — the 'why/how'. An MIO without a transmission chain is rejected.",
      "items": {
        "type": "object",
        "required": ["chain", "score", "sign", "mechanism"],
        "properties": {
          "chain": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "sign": { "type": "integer", "enum": [-1, 0, 1] },
          "mechanism": { "type": "string" }
        }
      }
    },

    "affected_sectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sector", "direction", "score"],
        "properties": {
          "sector": { "type": "string" },
          "direction": { "type": "string", "enum": ["Up", "Down", "Neutral"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "mechanism": { "type": "string" },
          "horizon_bias": {
            "type": "string",
            "enum": ["immediate", "short", "medium", "structural"]
          }
        }
      }
    },

    "affected_companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "direction", "score"],
        "properties": {
          "company": { "type": "string" },
          "direction": { "type": "string", "enum": ["Up", "Down", "Neutral"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "nifty_weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "exposure_vector": { "type": "object" },
          "analogues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_ref": { "type": "string" },
                "reaction": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "expected_direction": {
      "type": "object",
      "additionalProperties": { "type": "string", "enum": ["Up", "Down", "Neutral"] }
    },

    "impact": {
      "type": "object",
      "required": ["immediate", "short", "medium", "structural"],
      "description": "Four horizons, never blended.",
      "properties": {
        "immediate": { "$ref": "#/$defs/impactBucket" },
        "short": { "$ref": "#/$defs/impactBucket" },
        "medium": { "$ref": "#/$defs/impactBucket" },
        "structural": { "$ref": "#/$defs/impactBucket" }
      }
    },

    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge", "expected_sign", "observed_sign", "status"],
        "properties": {
          "edge": { "type": "string" },
          "expected_sign": { "type": "integer", "enum": [-1, 0, 1] },
          "observed_sign": { "type": "integer", "enum": [-1, 0, 1] },
          "status": { "type": "string", "enum": ["CONFIRMED", "OVERRIDDEN", "WEAKENED"] },
          "reason": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "OVERRIDDEN" } } },
            "then": { "required": ["reason"] }
          }
        ]
      }
    },

    "confidence": {
      "type": "object",
      "required": ["econ_rationale_stars", "historical_reliability", "today_confidence"],
      "description": "The confidence triple. No direction ships without it.",
      "properties": {
        "econ_rationale_stars": { "type": "integer", "minimum": 1, "maximum": 5 },
        "historical_reliability": { "type": "number", "minimum": 0, "maximum": 1 },
        "today_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reliability_tag": { "type": "string", "enum": ["PRIOR", "CALIBRATED"] }
      }
    },

    "driver_dominance": {
      "type": "object",
      "required": ["vector", "dominant_driver", "dominant_driver_score"],
      "properties": {
        "vector": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "dominant_driver": { "type": "string" },
        "dominant_driver_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "provenance": {
      "type": "object",
      "required": ["core_version"],
      "properties": {
        "pipeline_run": { "type": "string" },
        "core_version": { "type": "string" }
      }
    }
  },

  "$defs": {
    "impactBucket": {
      "type": "object",
      "required": ["direction", "magnitude", "unit"],
      "properties": {
        "direction": { "type": "string", "enum": ["Up", "Down", "Neutral"] },
        "magnitude": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
